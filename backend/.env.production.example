# Reference only: set these in Render Environment; .NET does NOT auto-load this file.
ASPNETCORE_ENVIRONMENT=Production
# Render provides PORT itself. Do not add a port to the public Pages API URL.
ConnectionStrings__Default=Host=YOUR_ENDPOINT-pooler.REGION.aws.neon.tech;Database=neondb;Username=YOUR_USER;Password=YOUR_PRIVATE_PASSWORD;SSL Mode=VerifyFull;Maximum Pool Size=5;Timeout=30;Command Timeout=30
ConnectionStrings__Migrations=Host=YOUR_ENDPOINT.REGION.aws.neon.tech;Database=neondb;Username=YOUR_USER;Password=YOUR_PRIVATE_PASSWORD;SSL Mode=VerifyFull;Timeout=30;Command Timeout=60
AllowedOrigins=https://YOUR_PAGES_PROJECT.pages.dev
Bootstrap__Email=YOUR_ADMIN_EMAIL
Bootstrap__Password=YOUR_PRIVATE_INITIAL_PASSWORD_AT_LEAST_12_CHARACTERS
R2__Endpoint=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2__Bucket=amora-mini-products
R2__AccessKeyId=YOUR_BUCKET_SCOPED_ACCESS_KEY_ID
R2__SecretAccessKey=YOUR_BUCKET_SCOPED_SECRET_ACCESS_KEY
